<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AgentOS • Governance Console</title>
  <link id="themeLink" rel="stylesheet" href="./core/theme-arzin.css" />
  <link rel="stylesheet" href="css/responsive.css" />
</head>
<body data-brand="arzin">
  <div class="shell">
    <aside class="sidebar">
      <div class="brand">
        <img src="./assets/img/agentoslogo.png" alt="AgentOS" />
        <div>
          <div class="t1" id="brandTitle">Arzin</div>
          <div class="t2">AgentOS Governance Console</div>
        </div>
      </div>
      <div class="controls">
        <select class="select" id="brandSel">
          <option value="arzin">Arzin</option>
          <option value="pedramflow">PedramFlow</option>
        </select>
        <select class="select" id="localeSel">
          <option value="fa-IR">فارسی (RTL)</option>
          <option value="en-US">English (LTR)</option>
        </select>
      </div>
      <div class="nav">
        <div class="badge" id="navOs">OS</div>
        <a href="#/os/os-dashboard" data-titlekey="nav.os">OS</a>
        <a href="#/os/os-governance-console" data-titlekey="os.gov_console">Governance Console</a>
        <a href="#/os/os-policy-browser" data-titlekey="os.policy_browser">Policy Browser</a>
        <a href="#/os/os-permit-review" data-titlekey="os.permit_review">Permit Review</a>
        <a href="#/os/os-audit-trace" data-titlekey="os.audit_trace">Audit Trace</a>
        <a href="#/os/os-channel-manager" data-titlekey="os.channel_manager">Channel Manager</a>
        <a href="#/os/os-agent-registry" data-titlekey="os.agent_registry">Agent Registry</a>

        <div style="height:10px"></div>
        <div class="badge" id="navInfra">Infra</div>
        <a href="#/infra/infra-overview" data-titlekey="infra.overview">Infra Overview</a>
        <a href="#/infra/infra-kafka-health" data-titlekey="infra.kafka">Kafka</a>
        <a href="#/infra/infra-k8s-topology" data-titlekey="infra.k8s">K8s</a>
        <a href="#/infra/infra-security-posture" data-titlekey="infra.security">Security</a>

        <div style="height:10px"></div>
        <div class="badge" id="navDomain">Domain</div>
        <a href="#/domain/domain-recommendations" data-titlekey="domain.reco">Recommendations</a>
        <a href="#/domain/domain-scenario-planner" data-titlekey="domain.scenario">Scenario Planner</a>

        <div style="height:10px"></div>
        <div class="badge" id="navInteraction">Interaction</div>
        <a href="#/interaction/interaction-intent-input" data-titlekey="interaction.intent_input">Intent</a>
        <a href="#/interaction/interaction-exec-approval" data-titlekey="interaction.exec_approval">Approval</a>
      </div>
      <div class="footer">
        <div class="note">Core: Role → View → Action (Permit)</div>
        <div class="note">i18n: fa-IR / en-US + RTL/LTR switch</div>
      </div>
    </aside>
    <main class="main">
      <div id="view" class="grid" style="position:relative;z-index:1;"></div>
    </main>
  </div>
  <script type="module">
    import { boot } from './core/core-router.js';
    boot();
  </script>
</body>
</html>
