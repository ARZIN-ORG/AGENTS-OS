{
  "title": "ARZIN AACP Phase-1",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "ALLOW (5m)",
      "targets": [
        {
          "expr": "increase(aacp_allow_total[5m])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DENY (5m)",
      "targets": [
        {
          "expr": "increase(aacp_deny_total[5m])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fail-Closed (5m)",
      "targets": [
        {
          "expr": "increase(aacp_fail_closed_total[5m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Permit Latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aacp_permit_latency_ms_bucket[5m])) by (le))"
        }
      ]
    }
  ]
}